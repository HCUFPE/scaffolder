  "info": {
    "title": "AppStart API",
    "description": "API REST do AppStart - Especificação OpenAPI 3.0",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "appstart_session",
        "description": "Cookie de sessão local opaca"
      }
    },
    "schemas": {
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://appstart.example/problems/validation-error"
          },
          "title": {
            "type": "string",
            "example": "Dados inválidos"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Um ou mais campos precisam ser corrigidos."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/users"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "requestId": {
            "type": "string",
            "example": "01J..."
          },
          "timestamp": {
            "type": "string",
            "example": "2026-08-31T20:00:00.000Z"
          },
          "errors": {
            "type": "object",
            "example": {
              "email": [
                "Informe um e-mail válido."
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "timestamp"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin@appstart.internal",
            "description": "E-mail ou nome de usuário cadastrado"
          },
          "password": {
            "type": "string",
            "example": "Admin123!",
            "description": "Senha de acesso"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "SafeUserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "example": "USER"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "AuthMeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SafeUserProfileDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "ManagedUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "example": "USER"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-08-31T20:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-08-31T20:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 20
          },
          "total": {
            "type": "number",
            "example": 100
          },
          "totalPages": {
            "type": "number",
            "example": 5
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "totalPages"
        ]
      },
      "PaginatedUsersResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManagedUserDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "example": "ada@example.com",
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "example": "USER"
          }
        },
        "required": [
          "name",
          "email",
          "role"
        ]
      },
      "UpdateSelfUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "example": "ada@example.com",
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ],
            "example": "ADMIN"
          }
        }
      },
      "SetUserStatusDto": {
        "type": "object",
        "properties": {
          "isActive": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "isActive"
        ]
      },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Título da tarefa",
            "example": "Configurar monitoramento de produção",
            "minLength": 3,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "description": "Descrição detalhada da tarefa",
            "example": "Definir alertas para uso de CPU e memória.",
            "maxLength": 1000
          },
          "priority": {
            "type": "string",
            "description": "Prioridade da tarefa",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ],
            "default": "MEDIUM"
          },
          "dueDate": {
            "type": "string",
            "description": "Data de entrega limite (ISO 8601)",
            "example": "2026-12-31T23:59:59.000Z"
          }
        },
        "required": [
          "title"
        ]
      },
      "TaskOwnerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único do proprietário",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "name": {
            "type": "string",
            "description": "Nome do proprietário",
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "description": "E-mail do proprietário",
            "example": "ada@example.com"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "TaskDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único da tarefa",
            "example": "b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a22"
          },
          "title": {
            "type": "string",
            "description": "Título da tarefa",
            "example": "Configurar monitoramento"
          },
          "description": {
            "type": "object",
            "description": "Descrição da tarefa",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Status da tarefa",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED"
            ],
            "example": "PENDING"
          },
          "priority": {
            "type": "string",
            "description": "Prioridade da tarefa",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ],
            "example": "MEDIUM"
          },
          "dueDate": {
            "type": "object",
            "description": "Data limite de entrega",
            "nullable": true
          },
          "ownerId": {
            "type": "string",
            "description": "Identificador do usuário proprietário",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "owner": {
            "description": "Dados resumidos do proprietário",
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskOwnerDto"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "description": "Data de criação"
          },
          "updatedAt": {
            "type": "string",
            "description": "Data de última atualização"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "ownerId",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginatedTasksResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Lista de tarefas paginadas",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskDto"
            }
          },
          "meta": {
            "description": "Metadados de paginação",
            "allOf": [
              {
                "$ref": "#/components/schemas/PaginationMetaDto"
              }
            ]
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Título da tarefa",
            "example": "Configurar monitoramento avançado",
            "minLength": 3,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "description": "Descrição detalhada da tarefa",
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "description": "Status atual da tarefa",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "priority": {
            "type": "string",
            "description": "Prioridade da tarefa",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ]
          },
          "dueDate": {
            "type": "string",
            "description": "Data de entrega limite (ISO 8601)"
          }
        }
      }
    }
  }
}
