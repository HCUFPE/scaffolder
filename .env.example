# Ambiente
NODE_ENV=development

# API
API_PORT=3000
# API_BASE_URL é derivada automaticamente como http://localhost:${API_PORT}.
# Defina apenas se precisar de uma URL diferente (ex: Codespaces, produção).
# API_BASE_URL=https://meu-dominio.com

# Frontend
WEB_PORT=5173
# WEB_BASE_URL segue a mesma lógica de API_BASE_URL.
# WEB_BASE_URL=https://meu-dominio.com

# PostgreSQL local via Docker Compose
POSTGRES_DB=data_vivian
POSTGRES_USER=data_vivian
POSTGRES_PASSWORD=data_vivian_dev_password
POSTGRES_PORT=5432
KEYCLOAK_DB_NAME=data_vivian_keycloak

# Prisma / conexão com banco da aplicação
DATABASE_URL=postgresql://data_vivian:data_vivian_dev_password@localhost:5432/data_vivian?schema=public

# Keycloak
KEYCLOAK_PORT=8080
# KEYCLOAK_BASE_URL segue a mesma lógica de API_BASE_URL.
# KEYCLOAK_BASE_URL=https://id.meu-dominio.com
KEYCLOAK_REALM=vivian-projeto
KEYCLOAK_CLIENT_ID=vivian-projeto-server
KEYCLOAK_CLIENT_SECRET=vivian_projeto_dev_client_secret
KEYCLOAK_ADMIN_CLIENT_ID=vivian-projeto-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=vivian_projeto_dev_admin_client_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PASSWORD_MIN_LENGTH=12

# Sessão
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=vivian_projeto_session
OIDC_CORRELATION_TTL_SECONDS=300
SESSION_CLEANUP_INTERVAL_MINUTES=60

# Usuários de desenvolvimento
DEV_ADMIN_EMAIL=vivianazevedo@gmail.com
DEV_ADMIN_PASSWORD=ChangeMe123456!
DEV_ADMIN_NAME=Administrador
DEV_USER_EMAIL=user@vivian-projeto.local
DEV_USER_PASSWORD=ChangeMe123456!
DEV_USER_NAME=Usuário
