# Ambiente
NODE_ENV=development

# API — mantenha API_BASE_URL consistente com API_PORT no desenvolvimento local
API_PORT=3000
API_BASE_URL=http://localhost:3000

# Frontend — mantenha WEB_BASE_URL consistente com WEB_PORT no desenvolvimento local
WEB_PORT=5173
WEB_BASE_URL=http://localhost:5173

# PostgreSQL local via Docker Compose
POSTGRES_DB=appstart
POSTGRES_USER=appstart
POSTGRES_PASSWORD=appstart_dev_password_change_me
POSTGRES_PORT=5432
KEYCLOAK_DB_NAME=appstart_keycloak

# Prisma / conexão com banco da aplicação
DATABASE_URL=postgresql://appstart:appstart_dev_password_change_me@localhost:5432/appstart?schema=public

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=appstart
KEYCLOAK_CLIENT_ID=appstart-server
KEYCLOAK_CLIENT_SECRET=appstart_dev_client_secret_change_me
KEYCLOAK_ADMIN_CLIENT_ID=appstart-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=appstart_dev_admin_client_secret_change_me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PASSWORD_MIN_LENGTH=12

# Sessão
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=appstart_session
OIDC_CORRELATION_TTL_SECONDS=300
SESSION_CLEANUP_INTERVAL_MINUTES=60

# Usuários de desenvolvimento
DEV_ADMIN_EMAIL=admin@appstart.local
DEV_ADMIN_PASSWORD=ChangeMe123456!
DEV_ADMIN_NAME=Administrador
DEV_USER_EMAIL=user@appstart.local
DEV_USER_PASSWORD=ChangeMe123456!
DEV_USER_NAME=Usuário
